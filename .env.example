# Skopiuj do .env i zmień w razie potrzeby:  cp .env.example .env
# Projekt NIE wymaga żadnych kluczy ani haseł — API dane.gov.pl jest publiczne.
# Gdyby w przyszłości potrzebny był klucz, trzymaj go tylko tutaj (plik .env jest w .gitignore).

# Port, na którym działa aplikacja
PORT=8080

# Źródło danych: dane.gov.pl (pełne dane) albo sample (próbka offline)
DATA_SOURCE=dane.gov.pl

# Adres API portalu dane.gov.pl
DANE_API_URL=https://api.dane.gov.pl/1.4

# Limit czasu pobierania plików (sekundy)
HTTP_TIMEOUT=120

# Katalogi (dla uruchomienia bez Dockera)
DATA_DIR=data/raw
OUTPUT_DIR=web/data
